# AI Knockout — Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to Git

# Application
APP_ENV=development
API_PORT=8000
LOG_LEVEL=info

# Security — REQUIRED: Generate a strong random key
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET_KEY

# PostgreSQL
POSTGRES_USER=aik_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
POSTGRES_DB=aik_db
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
